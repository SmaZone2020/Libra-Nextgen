<Window x:Class="LibraDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Libra Desktop"
        Height="820" Width="1240"
        MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded"
        Closing="OnClosing">
    <!-- Full-bleed WebView2 host; all controls live in the tray menu. -->
    <Grid x:Name="HostArea" ClipToBounds="True" />
</Window>