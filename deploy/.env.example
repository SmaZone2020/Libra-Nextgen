# Console API origin. 'same-origin' (default) mirrors the page host exactly — console and API
# share the nginx entry, so one image works for any intranet IP or public domain without
# baking the URL. An explicit URL overrides it; empty falls back to same-host:5270 (not recommended).
# NOTE: baked into the frontend at image build time; changing it requires --build
VITE_API_BASE=same-origin

# MongoDB connection string used by the server (default: unauthenticated mongo container).
# Auth example: mongodb://libra:CHANGE_ME@mongo:27017/libra_nextgen?authSource=admin
MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE=libra_nextgen
# First-init root credentials for the mongo container (empty data volume only); empty = no auth
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Legacy pre-session shared secret (hybrid-crypto registration does not need it)
BEACON_SECRET=

# ── Builder mode ─────────────────────────────────────────────────────────
# template (default): payloads are packaged (pure .NET) from prebuilt platform
# templates downloaded from the GitHub release — no Rust toolchain needed.
# source: compile in-image — build with deploy/Dockerfile.source instead.
LIBRA_BUILDER_MODE=template
# Where templates come from (see docs/platform-support.md):
LIBRA_TEMPLATE_REPO=SmaZone2020/Libra-Nextgen
LIBRA_TEMPLATE_TAG=latest
# GitHub PAT with repo read scope — required when LIBRA_TEMPLATE_REPO is private
LIBRA_TEMPLATE_TOKEN=
# Optional self-hosted mirror base URL (asset URL = {base}/libra-agent-tpl-{platform}.zip)
LIBRA_TEMPLATE_BASE_URL=

# ── Only for deploy/Dockerfile.source (LIBRA_BUILDER_MODE=source) ─────────
# zig version pinned for cargo-zigbuild compatibility
ZIG_VERSION=0.14.1
# zig download base. Official: https://ziglang.org/download (default when empty).
# NOTE: no reliable GitHub mirror exists for the pinned 0.14.1 prebuilt assets —
# keep empty and let the official source download (slow on CN networks, one-time).
ZIG_BASE_URL=

# CN mirror overrides for the in-image Rust toolchain (optional; empty = official sources).
# Example for rsproxy.cn — speeds up the rustup + crates.io steps on restricted networks:
# RUSTUP_DIST_SERVER=https://rsproxy.cn
# RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup
# CARGO_REGISTRY_INDEX=sparse+https://rsproxy.cn/index/
RUSTUP_DIST_SERVER=
RUSTUP_UPDATE_ROOT=
CARGO_REGISTRY_INDEX=

HTTP_PORT=80
HTTPS_PORT=443