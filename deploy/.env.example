# Origin the console is served from. Works for intranet HTTP (e.g. http://192.168.1.10)
# and public HTTPS (e.g. https://c2.example.com); all console API/SSE/WS calls target it via nginx.
# Leave empty to fall back to same-host:5270 direct mode (not recommended).
# NOTE: baked into the frontend at image build time; changing it requires --build
VITE_API_BASE=https://c2.example.com

# MongoDB connection string used by the server (default: unauthenticated mongo container).
# Auth example: mongodb://libra:CHANGE_ME@mongo:27017/libra_nextgen?authSource=admin
MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE=libra_nextgen
# First-init root credentials for the mongo container (empty data volume only); empty = no auth
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Legacy pre-session shared secret (hybrid-crypto registration does not need it)
BEACON_SECRET=

# zig version pinned for cargo-zigbuild compatibility
ZIG_VERSION=0.14.1

# CN mirror overrides for the in-image Rust toolchain (optional; empty = official sources).
# Example for rsproxy.cn — speeds up the rustup + crates.io steps on restricted networks:
# RUSTUP_DIST_SERVER=https://rsproxy.cn
# RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup
# CARGO_REGISTRY_INDEX=sparse+https://rsproxy.cn/index/
RUSTUP_DIST_SERVER=
RUSTUP_UPDATE_ROOT=
CARGO_REGISTRY_INDEX=

HTTP_PORT=80
HTTPS_PORT=443