{
  "schemaVersion": 1,
  "pluginId": "com.example.plugin-sdk",
  "name": "插件开发 SDK 示例",
  "version": "1.0.0",
  "author": "libra",
  "description": "标准示例插件：前端展示所有可调用组件与 API（活文档），Agent 端模块展示所有平台 API 与多平台 #if 写法。",
  "entry": {
    "route": "plugin-sdk",
    "label": "nav.pluginSdk",
    "icon": "Puzzle",
    "apiRoot": "/api/plugins/com.example.plugin-sdk"
  },
  "i18n": {
    "zh": { "nav.pluginSdk": "插件 SDK 示例" },
    "en": { "nav.pluginSdk": "Plugin SDK Demo" }
  },
  "actions": [
    {
      "action": "showcase",
      "label": "运行能力展示",
      "method": "POST",
      "argsSchema": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "title": "能力名称（whoami/fs/proc/network/system）"
          }
        }
      },
      "module": {
        "kind": "script",
        "name": "plugin_sdk",
        "op": "showcase",
        "entry": "main"
      }
    },
    {
      "action": "shell",
      "label": "执行 Shell 命令",
      "method": "POST",
      "argsSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "title": "要执行的命令"
          }
        },
        "required": ["command"]
      },
      "module": {
        "kind": "script",
        "name": "plugin_sdk",
        "op": "shell",
        "entry": "main"
      }
    }
  ]
}
